{
  "name": "reachinbox-email-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade email scheduler service (BullMQ + Redis + Ethereal)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:all": "concurrently -k -n api,worker \"node dist/index.js\" \"node dist/workers/emailWorker.js\"",
    "worker": "node dist/workers/emailWorker.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/workers/emailWorker.ts"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "concurrently": "^8.2.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.0",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
